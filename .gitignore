# ---------------------------------------------------------------------------
# SpectraFlow: track code + README only. Data, checkpoints, results, and the
# LaTeX/PDF sources are intentionally excluded from the public code release.
# ---------------------------------------------------------------------------

# Datasets and raw/processed spectra (multi-GB; distributed via their sources)
data/
datasets/

# Trained model weights and runtime outputs
checkpoints/
downstream/
results/

# Manuscript sources and build artifacts (not part of the code release)
latex/

# Standalone figure/image exports at repo root
/*.png
/*.pdf
*.eps
/*.svg

# Keep README/documentation images
!docs/
!docs/**

# Handoff / experiment scratch notes
OPENSPECY_EXPERIMENT_HANDOFF.md

# Local LaTeX toolchain (Tectonic binary, etc.)
.tooling/

# PDF edit backups / temp outputs
*.bak
*.pdf.bak
*.new.pdf

# Python caches and virtual envs
__pycache__/
*.py[cod]
.venv/
venv/

# Editor / OS cruft
.vscode/
.DS_Store
Thumbs.db

# Accidental files from shell redirection
/--data_dir
/--source_csv
/python
