# Auto detect text files and perform LF normalization
* text=auto

# Preserve generated/vector assets and the verbatim manuscript/vendor snapshot.
*.pdf binary
*.png binary
*.npz binary
*.eps binary
*.svg text -whitespace
latex/** -whitespace
reproduction_audit/manuscript_snapshot/** -whitespace

# Markdown may use intentional two-space hard line breaks.
*.md whitespace=-blank-at-eol
